{
  "name": "nosdag",
  "private": true,
  "version": "0.1.0",
  "description": "Nosdag desktop shell — Electron app: a clearnet Kubo node or an anonymous Helia-over-Tor node in the main process, behind a privileged app:// renderer.",
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.mjs && node --check preload.cjs && echo 'syntax OK'",
    "clean": "rm -rf .tmp"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^16.1.0",
    "@chainsafe/libp2p-yamux": "^7.0.1",
    "@helia/block-brokers": "^4.2.1",
    "@helia/dag-cbor": "^4.0.4",
    "@helia/routers": "^3.1.3",
    "@helia/unixfs": "^4.0.3",
    "@helia/utils": "^1.4.0",
    "@ipld/car": "^5.4.6",
    "@ipld/dag-cbor": "^9.2.7",
    "@ipld/dag-pb": "^4.1.7",
    "@libp2p/identify": "^3.0.29",
    "@libp2p/websockets": "^9.2.13",
    "@multiformats/multiaddr": "^12.4.0",
    "blockstore-fs": "^2.0.2",
    "datastore-fs": "^10.0.2",
    "helia": "^5.3.0",
    "kubo": "^0.41.0",
    "kubo-rpc-client": "^5.0.2",
    "libp2p": "^2.8.5",
    "multiformats": "^13.3.1",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^42.5.0"
  },
  "build": {
    "//": "electron-builder config (not wired yet) — the §4.1 asar-unpack of the Go binary lives here",
    "appId": "com.nosdag.app",
    "asarUnpack": [
      "node_modules/kubo/kubo/**"
    ]
  }
}
